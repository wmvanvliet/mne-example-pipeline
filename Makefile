
help:
	@echo "Please use \`make <target>' where <target> is one of:"
	@echo "  all         all processing, both in sensor and source space"
	@echo "  sensor      all processing in sensor space"
	@echo "  source      all processing in sourse space"
	@echo "Or use one of these to run individual steps:"
	@echo "  bids        convert the original data to BIDS format"
	@echo "  tsss        run maxfilter on the data to perform TSSS filtering"
	@echo "  ica         use ICA to remove eye blinks and heart beat"
	@echo "  epochs      create epochs and evoked responses"
	@echo "  noise_cov   compute the noise covariance"
	@echo "  freesurfer  run FreeSurfer segmentation of the MRIs"
	@echo "  forward     compute the forward model"
	@echo "  inverse     compute the inverse (source estimates)"
	@echo "  ga          compute the grand-average across subjects"
	@echo "  clean	     remove intermediate scripts generated by processing"

# All the subjects to run the analysis for.
SUBJ := 1 2

# Groups of processing steps.
sensor: tsss ica epochs noise_cov
source: forward inverse
all: sensor source ga

# Individual processing steps.
tsss:
	for i in $(SUBJ); do \
		python 02_tsss.py -sub $$i -ses 1 -task audvis -run 1; \
		python 02_tsss.py -sub $$i -ses 1 -task audvis -run 2; \
		python 02_tsss.py -sub $$i -ses 2 -task audvis -run 1; \
		python 02_tsss.py -sub $$i -ses 2 -task audvis -run 2; \
	done

ica:
	for i in $(SUBJ); do \
		python 03_ica.py -sub $$i -ses 1 -task audvis -run 1; \
		python 03_ica.py -sub $$i -ses 1 -task audvis -run 2; \
		python 03_ica.py -sub $$i -ses 2 -task audvis -run 1; \
		python 03_ica.py -sub $$i -ses 2 -task audvis -run 2; \
	done

epochs:
	for i in $(SUBJ); do \
		python 04_epochs.py -sub $$i -ses 1 -task audvis;\
		python 04_epochs.py -sub $$i -ses 2 -task audvis;\
	done

noise_cov: 
	for i in $(SUBJ); do \
		python 05_noise_cov.py -sub $$i -ses 1;\
		python 05_noise_cov.py -sub $$i -ses 2;\
	done	

freesurfer: 
	for i in $(SUBJ); do \
		python 06_freesurfer.py -sub $$i;\
	done

forward: 
	for i in $(SUBJ); do \
		python 08_forward.py -sub $$i;\
	done

inverse:
	for i in $(SUBJ); do \
		python 09_inverse.py -sub $$i -ses 1 -task audvis;\
		python 09_inverse.py -sub $$i -ses 2 -task audvis;\
	done

ga:
	python 10_grand_average.py
